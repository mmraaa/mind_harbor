# ===== 数据库 (PostgreSQL 业务数据) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mindharbor
POSTGRES_USER=mindharbor
POSTGRES_PASSWORD=mindharbor

# ===== 向量库 (Milvus v3.0.0,本机 Docker 已部署) =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=knowledge_chunks

# ===== 认证 =====
JWT_SECRET=dev-change-me-0123456789abcdefghij
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== CORS =====
CORS_ORIGINS=["*"]  # 团队开发放开,生产收紧

# ===== 大模型 (DeepSeek 示例,可换通义/智谱:改 BASE_URL/MODEL) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding =====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=

# ===== TTS (流式语音陪伴) =====
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=longanhuan_v3.6

# ===== 随手画审核（DashScope 原生多模态） =====
DOODLE_REVIEW_API_KEY=
DOODLE_REVIEW_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
DOODLE_REVIEW_MODEL=qwen3.7-plus
