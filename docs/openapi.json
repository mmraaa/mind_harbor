          },
          "end_session": {
            "type": "boolean",
            "title": "End Session",
            "description": "是否结束会话并生成情绪日记",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "ChatRequest",
        "description": "聊天请求;end_session=True 表示本轮为会话收尾,触发情绪日记闭环。"
      },
