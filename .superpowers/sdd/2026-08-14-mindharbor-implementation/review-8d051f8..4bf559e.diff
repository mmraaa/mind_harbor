+def test_search_keyword_hybrid_boost(db, milvus_store, patch_embed, tmp_path):
+    """可选关键词混合:向量检索命中之外,关键词命中(如"热线")应被召回并前置。"""
+    _ingest_fixture(db, milvus_store, tmp_path)
