+    p1.write_text(SAMPLE_DOC, encoding="utf-8")
+    p2 = tmp_path / "咨询流程.md"
+    p2.write_text(FLOW_DOC, encoding="utf-8")
+    ingest_document(p1, db=db, store=milvus_store)
+    ingest_document(p2, db=db, store=milvus_store)
+    return p1, p2
